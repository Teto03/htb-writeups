# HTB VPN profiles contain personal credentials
*.ovpn

# Write-ups of ACTIVE content stay local until retirement
# (per-folder exclusions go in .git/info/exclude)
private/
active/

# Flags
flag.txt
*flag*.txt
user.txt
root.txt

# Loot and working folders
loot/
sample/
extracted/
work/

# Full nmap output formats (plain -oN output is kept)
*.nmap
*.gnmap
*.xml

# HTB artefacts: archives
*.zip
*.7z
*.rar

# HTB artefacts: logs and network captures
*.evtx
*.pcap
*.pcapng

# HTB artefacts: memory and disk images
*.raw
*.mem
*.vmem
*.dmp
*.lime
*.E01
*.img
*.vmdk
*.vhd
*.vhdx

# HTB artefacts: executables and samples
*.exe
*.dll
*.elf
*.bin

# Editor / OS junk
.DS_Store
.vscode/
.idea/
*.swp
